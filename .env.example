# CyberNexa environment configuration template
# Copy this file to .env and replace placeholders with your own values.
# Never commit the real .env file or expose real API keys.

# --------------------------------------------------
# LLM provider routing
# --------------------------------------------------

# The main provider is selected in:
# 1.3_models/provider_config.yaml
#
# This variable remains for backward compatibility.
LLM_PROVIDER=ollama

# --------------------------------------------------
# Groq cloud provider
# --------------------------------------------------

# Required only when Groq is selected.
GROQ_API_KEY=replace_with_your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# --------------------------------------------------
# OpenAI cloud provider
# --------------------------------------------------

# Required only when OpenAI is selected.
OPENAI_API_KEY=replace_with_your_openai_api_key
OPENAI_MODEL=gpt-5-mini

# --------------------------------------------------
# Ollama local provider
# --------------------------------------------------

# Ollama runs locally and does not require an API key.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --------------------------------------------------
# Shared model settings
# --------------------------------------------------

LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# --------------------------------------------------
# Rate limiting and cost governance
# --------------------------------------------------

RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60
LLM_DAILY_REQUEST_LIMIT=250

# --------------------------------------------------
# Survey links
# --------------------------------------------------

PRE_SURVEY_URL=replace_with_pre_survey_url
POST_SURVEY_URL=replace_with_post_survey_url