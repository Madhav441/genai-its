# GenAI ITS Environment Configuration
# Copy this file to .env and replace placeholder values with real credentials.
# Do not commit the real .env file to GitHub.

# LLM Provider Configuration
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# LLM Runtime Settings
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# Optional Survey URLs
# These can be left blank if surveys are not used.
PRE_QUIZ_SURVEY_URL=
POST_QUIZ_SURVEY_URL=

# Optional Future Providers
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional Local Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3