# Default provider: ollama, groq, or openai
LLM_PROVIDER=ollama

# Groq cloud provider
GROQ_API_KEY=replace_with_your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b

# OpenAI cloud provider
OPENAI_API_KEY=replace_with_your_openai_api_key
OPENAI_MODEL=gpt-5-mini

# Ollama local provider
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Shared generation settings
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# Governance and usage limits
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60
LLM_DAILY_REQUEST_LIMIT=250
LLM_DAILY_BUDGET_USD=1.00

# Optional survey URLs
PRE_QUIZ_SURVEY_URL=
POST_QUIZ_SURVEY_URL=

GOOGLE_API_KEY=#replace with your google api key (secondary LLM parse)